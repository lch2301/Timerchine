<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>IntervalTimer.SettingsUpgradeChecks</StartupObject>
    <DefineConstants>$(DefineConstants);TIMERCHINE_EXTERNAL_LINKS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\*.cs" Exclude="..\..\Program.cs;..\..\ResponsiveTimerForm.cs;..\..\HotkeySettingsForm.cs" />
    <Compile Include="Program.cs" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <EmbeddedResource Include="..\..\Assets\IntervalTimer.ico" LogicalName="IntervalTimer.Assets.IntervalTimer.ico" />
    <EmbeddedResource Include="..\..\Assets\Fonts\*.ttf" LogicalName="IntervalTimer.Assets.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
